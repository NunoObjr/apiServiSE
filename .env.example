# String de conexão do MongoDB (ex.: mongodb+srv://usuario:senha@cluster.mongodb.net/banco?retryWrites=true&w=majority)
MONGO_URI=
# Segredo usado para assinar os tokens JWT (use um valor longo e aleatório)
JWT_SECRET=
# Validade dos tokens (opcional, padrão 7d)
JWT_EXPIRES_IN=7d
# Upload no S3 (opcional)
BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
